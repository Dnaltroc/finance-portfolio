# Copy to .env and fill in. Never commit .env.

# SEC requires every EDGAR client to identify itself. Format: "Name email@domain"
SEC_IDENTITY="Your Name you@example.com"

# Free key from https://finnhub.io (60 calls/min on the free tier)
FINNHUB_KEY=

# Set to 1 to run every provider from tests/fixtures instead of the network
FINLIB_OFFLINE=0
